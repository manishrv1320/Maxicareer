# Copy to .env.local and fill in. Never commit real values.

# --- MongoDB (required) -------------------------------------------------------
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=maxicareer

# --- First administrator (created on first start if no admin exists) ---------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Maxicareer Admin

# --- Azure Blob Storage (uploads: photos, chat attachments, website images) ---
# Storage account > Security + networking > Access keys > Connection string.
# The container is created automatically and stays private; files are served
# through /api/files/<id> with short-lived SAS links.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=maxicareer-uploads
# Alternative to the connection string:
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=

# --- Email via Resend (optional) ----------------------------------------------
# Used for sign-in codes and enquiry alerts. Without it, emails are logged to the
# server console (and sign-in codes are shown on screen in development only).
RESEND_API_KEY=
MAIL_FROM=Maxicareer <noreply@yourdomain.com>
# Sender of "Forgot password" emails. Its domain must be verified in Resend (Domains).
SUPPORT_MAIL_FROM=Maxicareer Support <support@maxicareer.com>
# Public address of the site, used in links inside emails (e.g. https://maxicareer.com).
# Set it in production so password-reset links always point at your own site.
APP_URL=
# Inbox that receives contact-form enquiries
CONTACT_EMAIL=

# --- Sample data ----------------------------------------------------------------
# One-click sample student sign-in works only while an admin has loaded sample
# data. Set to false to disable it entirely in production.
ENABLE_DEMO_LOGIN=true

GEMINI_API_KEY=
