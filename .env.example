# Copy to .env.local and fill in. Never commit real values.

# --- MongoDB (required) -------------------------------------------------------
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=maxicareer

# --- First administrator (created on first start if no admin exists) ---------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Maxicareer Admin

# --- Azure Blob Storage (uploads: photos, chat attachments, website images) ---
# Storage account > Security + networking > Access keys > Connection string.
# The container is created automatically and stays private; files are served
# through /api/files/<id> with short-lived SAS links.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=maxicareer-uploads
# Alternative to the connection string:
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=

# --- Email (SMTP or Resend) ---------------------------------------------------
# Used for password resets, sign-in codes and enquiry alerts. SMTP wins when all three
# SMTP_HOST/SMTP_USER/SMTP_PASS are set; otherwise Resend is used if RESEND_API_KEY is set.
# Without either, emails are logged to the server console (and sign-in codes are shown on
# screen in development only).
# Zoho Mail (maxicareer.com): host smtp.zoho.eu, port 465. If two-factor sign-in is on,
# SMTP_PASS must be an app-specific password from Zoho (My Account > Security).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# With SMTP, both senders must be SMTP_USER or one of its aliases. With Resend, their
# domain must be verified in Resend (Domains).
MAIL_FROM=Maxicareer <noreply@yourdomain.com>
# Sender of "Forgot password" emails.
SUPPORT_MAIL_FROM=Maxicareer Support <support@maxicareer.com>
# Public address of the site, used in links inside emails (e.g. https://maxicareer.com).
# Set it in production so password-reset links always point at your own site.
APP_URL=
# Inbox that receives contact-form enquiries
CONTACT_EMAIL=

# --- Sample data ----------------------------------------------------------------
# Sample accounts have publicly known passwords. They can sign in (and the sign-in
# page lists them) only when this is true AND an admin has loaded sample data.
# Leave it false on any site other people can reach.
ENABLE_DEMO_LOGIN=false

GEMINI_API_KEY=
